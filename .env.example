# Docker Compose database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_hunter
DATABASE_URL=postgresql://postgres:postgres@db:5432/job_hunter

# Frontend / backend URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Auth
APP_ENV=development
AUTH_SECRET_KEY=change-me-in-production
AUTH_PREVIOUS_SECRET_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_DATA_ENCRYPTION_KEY=
FREE_DAILY_AGENT_RUN_LIMIT=3
PRO_DAILY_AGENT_RUN_LIMIT=50
FILL_REVIEW_ARTIFACT_DIR=storage/fill_review_artifacts
FILL_REVIEW_ARTIFACT_RETENTION_DAYS=14
USE_ALEMBIC_MIGRATIONS=false
AGENT_RUNNER_MODE=
AGENT_WORKER_POLL_SECONDS=2
AGENT_RUN_STALE_MINUTES=120
ENABLE_TRUE_AUTO_SUBMIT=false

# LLM providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Email
SMTP_EMAIL=
SMTP_PASSWORD=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
