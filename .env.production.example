# Copy this file to .env.production on the VPS. Never commit the real file.

# Compose / domain
COMPOSE_PROJECT_NAME=jobmatchkit
APP_DOMAIN=jobmatchkit.com
FRONTEND_URL=https://jobmatchkit.com
PUBLIC_API_URL=https://jobmatchkit.com/api
CORS_ALLOWED_ORIGINS=https://jobmatchkit.com
# Optional after publishing the browser extension, for example: ^chrome-extension://your-extension-id$
CORS_ALLOWED_ORIGIN_REGEX=
VITE_API_URL=/api

# Database
POSTGRES_USER=jobmatchkit
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=jobmatchkit
DATABASE_URL=postgresql://jobmatchkit:replace-with-a-long-random-password@db:5432/jobmatchkit

# Runtime security
APP_ENV=production
AUTH_SECRET_KEY=replace-with-32-plus-random-characters
AUTH_PREVIOUS_SECRET_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_DATA_ENCRYPTION_KEY=replace-with-32-plus-random-characters
APP_DATA_PREVIOUS_ENCRYPTION_KEYS=


# Billing / Stripe
# Use Stripe test keys locally. The webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
PRO_PLAN_PRICE_LABEL=$10/mo
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

# Matching workflow limits and worker mode
FREE_DAILY_AGENT_RUN_LIMIT=3
PRO_DAILY_AGENT_RUN_LIMIT=50
USE_ALEMBIC_MIGRATIONS=true
AGENT_RUNNER_MODE=worker
AGENT_WORKER_POLL_SECONDS=2
AGENT_WORKER_HEARTBEAT_SECONDS=10
AGENT_WORKER_HEARTBEAT_STALE_SECONDS=30
AGENT_WORKER_ID=
AGENT_RUN_STALE_MINUTES=120

# Fill-review artifacts

# True final submit stays off unless a separate pilot is approved.
ENABLE_TRUE_AUTO_SUBMIT=false
TRUE_SUBMIT_PILOT_USER_EMAILS=
TRUE_SUBMIT_PILOT_ATS_TYPES=

# Matching source policy
# Official company/ATS sources are searched before job boards. The bundled ranked
# company CSV is a seed; production can point at a fuller licensed ranking CSV
# with columns: rank,company,sector,role_tags,aliases.
FORTUNE_COMPANY_SEARCH_ENABLED=true
FORTUNE_COMPANIES_PER_PHASE=16
FORTUNE_MIN_CANDIDATE_JOBS=15
FORTUNE_COMPANY_RANKING_CSV=
MAX_TARGET_ROLE_SEARCH_TERMS=4
RELEVANT_OFFICIAL_COMPANIES_MAX=8
BOARD_LINK_RESOLUTION_TIMEOUT_SECONDS=20
BOARD_LINK_RESOLUTION_MAX_JOBS=24
JOBSPY_SEARCH_TIMEOUT_SECONDS=30
JOBSPY_LINKEDIN_FETCH_DESCRIPTION=false
CAREER_SEARCH_CANDIDATE_LIMIT=4
CAREER_SEARCH_HTTP_TIMEOUT_SECONDS=4
CAREER_SEARCH_COMPANY_TIMEOUT_SECONDS=12
LLM_STEP_TIMEOUT_SECONDS=90
LLM_ANALYSIS_TIMEOUT_SECONDS=120
LLM_ANALYSIS_CONCURRENCY=3

# LLM providers
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_MODEL=gpt-5-mini
OPENROUTER_MODEL=
GOOGLE_MODEL=
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Email
SMTP_EMAIL=
SMTP_PASSWORD=

# OAuth providers.
# With same-origin Caddy routing, external callback URLs should use /api.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobmatchkit.com/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://jobmatchkit.com/api/auth/linkedin/callback

# Optional backup settings for scripts/backup-postgres.sh.
# Prefer setting BACKUP_ENCRYPTION_PASSPHRASE outside the file when possible.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE=
R2_RCLONE_REMOTE=
