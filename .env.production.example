# Copy this file to .env.production on the VPS. Never commit the real file.

# Compose / domain
COMPOSE_PROJECT_NAME=jobmatchhero
APP_DOMAIN=jobmatchhero.example.com
FRONTEND_URL=https://jobmatchhero.example.com
CORS_ALLOWED_ORIGINS=https://jobmatchhero.example.com
VITE_API_URL=/api

# Database
POSTGRES_USER=jobmatchhero
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=jobmatchhero
DATABASE_URL=postgresql://jobmatchhero:replace-with-a-long-random-password@db:5432/jobmatchhero

# Runtime security
APP_ENV=production
AUTH_SECRET_KEY=replace-with-32-plus-random-characters
AUTH_PREVIOUS_SECRET_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_DATA_ENCRYPTION_KEY=replace-with-32-plus-random-characters
APP_DATA_PREVIOUS_ENCRYPTION_KEYS=


# Billing / Stripe
# Use Stripe test keys locally. The webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
PRO_PLAN_PRICE_LABEL=$10/mo
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

# Matching workflow limits and worker mode
FREE_DAILY_AGENT_RUN_LIMIT=3
PRO_DAILY_AGENT_RUN_LIMIT=50
USE_ALEMBIC_MIGRATIONS=true
AGENT_RUNNER_MODE=worker
AGENT_WORKER_POLL_SECONDS=2
AGENT_WORKER_HEARTBEAT_SECONDS=10
AGENT_WORKER_HEARTBEAT_STALE_SECONDS=30
AGENT_WORKER_ID=
AGENT_RUN_STALE_MINUTES=120

# Fill-review artifacts
FILL_REVIEW_ARTIFACT_DIR=storage/fill_review_artifacts
FILL_REVIEW_ARTIFACT_RETENTION_DAYS=14

# True final submit stays off unless a separate pilot is approved.
ENABLE_TRUE_AUTO_SUBMIT=false
TRUE_SUBMIT_PILOT_USER_EMAILS=
TRUE_SUBMIT_PILOT_ATS_TYPES=

# LLM providers
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_MODEL=gpt-5-mini
OPENROUTER_MODEL=
GOOGLE_MODEL=
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Email
SMTP_EMAIL=
SMTP_PASSWORD=

# OAuth providers.
# With same-origin Caddy routing, external callback URLs should use /api.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobmatchhero.example.com/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://jobmatchhero.example.com/api/auth/linkedin/callback

# Optional backup settings for scripts/backup-postgres.sh.
# Prefer setting BACKUP_ENCRYPTION_PASSPHRASE outside the file when possible.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE=
R2_RCLONE_REMOTE=
